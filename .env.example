# Postgres with pgvector extension enabled
DATABASE_URL=postgres://postgres:postgres@localhost:5432/docanalyzer

# openssl rand -base64 32
JWT_SECRET=change-me-to-a-32-byte-base64-secret

# Google AI Studio API key (free tier works)
GEMINI_API_KEY=your-gemini-key

# Local disk storage. Swap driver to "s3" and fill S3_* when needed.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
